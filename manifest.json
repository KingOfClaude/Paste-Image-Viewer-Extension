{
  "manifest_version": 3,
  "name": "Paste Image Viewer",
  "version": "2.0.0",
  "description": "Paste an image into the popup and view it in a full tab. Keeps a library of your pasted images.",
  "permissions": ["unlimitedStorage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Paste Image Viewer",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
